<script src="https://cdnjs.cloudflare.com/ajax/libs/three.js/r128/three.min.js" is:inline></script>
<script src="https://cdnjs.cloudflare.com/ajax/libs/gsap/3.12.5/gsap.min.js" is:inline></script>
<script is:inline>
  (function initWelcomeSplash() {
    const splash = document.getElementById('welcome-splash');
    if (!splash) return;
    splash.dataset.started = 'true';
    const body = document.body;
    body.classList.add('welcome-lock');
    const removeSplash = () => {
      body.classList.remove('welcome-lock');
      splash.remove();
    };
    // Decorative only: unsupported browsers and reduced-motion users skip the animation.
    if (!window.THREE || !window.gsap || window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
      removeSplash();
      return;
    }

    const gsap = window.gsap;
    let renderer;
    try {
      renderer = new window.THREE.WebGLRenderer({
        canvas: document.getElementById('welcome-three-canvas'),
        antialias: false,
        alpha: true
      });
    } catch (error) {
      console.warn('Intro animation unavailable; continuing to the portfolio.', error);
      removeSplash();
      return;
    }

    try {
      renderer.setPixelRatio(Math.min(window.devicePixelRatio || 1, 1.35));
      renderer.setSize(window.innerWidth, window.innerHeight);
      renderer.setClearColor(0x02030b, 1);

      const scene = new window.THREE.Scene();
      scene.fog = new window.THREE.FogExp2(0x050814, 0.00022);
      const camera = new window.THREE.PerspectiveCamera(68, window.innerWidth / window.innerHeight, 0.1, 2400);
      camera.position.z = 680;

      // A layered nebula: large, soft additive sprites create depth without external assets.
      const nebulaCanvas = document.createElement('canvas');
      nebulaCanvas.width = 256; nebulaCanvas.height = 256;
      const nebulaCtx = nebulaCanvas.getContext('2d');
      if (!nebulaCtx) {
        renderer.dispose();
        removeSplash();
        return;
      }
      const nebulaGradient = nebulaCtx.createRadialGradient(128,128,4,128,128,128);
      nebulaGradient.addColorStop(0, 'rgba(255,224,153,0.30)');
      nebulaGradient.addColorStop(0.20, 'rgba(120,105,210,0.22)');
      nebulaGradient.addColorStop(0.48, 'rgba(47,168,191,0.12)');
      nebulaGradient.addColorStop(1, 'rgba(8,12,35,0)');
      nebulaCtx.fillStyle = nebulaGradient;
      nebulaCtx.fillRect(0,0,256,256);
      const nebulaTexture = new window.THREE.CanvasTexture(nebulaCanvas);
      const nebulaGroup = new window.THREE.Group();
      const nebulaSprites = [];
      const nebulaColors = [0x8266df, 0x2fc2d0, 0xd5a858, 0x415bce, 0x9b6dff];
      for (let i = 0; i < 9; i += 1) {
        const material = new window.THREE.SpriteMaterial({
          map: nebulaTexture, color: nebulaColors[i % nebulaColors.length],
          transparent: true, opacity: 0, depthWrite: false, blending: window.THREE.AdditiveBlending
        });
        const sprite = new window.THREE.Sprite(material);
        sprite.position.set((Math.random() - 0.5) * 1550, (Math.random() - 0.5) * 1050, -300 - Math.random() * 900);
        const scale = 260 + Math.random() * 440;
        sprite.scale.set(scale * (1.1 + Math.random()), scale * (0.65 + Math.random() * 0.55), 1);
        sprite.material.rotation = (Math.random() - 0.5) * 1.2;
        nebulaGroup.add(sprite);
        nebulaSprites.push(sprite);
      }
      scene.add(nebulaGroup);

      // Near and far star layers give a gentle forward-flight feeling.
      const starLayers = [];
      const starCount = 1650;
      const palette = [[0.78,0.85,1],[1,0.91,0.69],[0.45,0.83,1],[0.72,0.63,1],[1,1,1]];
      for (const layer of [
        { count: 950, span: 1900, depth: 1350, size: 1.75, speed: 0.16 },
        { count: 520, span: 1650, depth: 950, size: 2.45, speed: 0.34 },
        { count: 180, span: 1250, depth: 580, size: 3.4, speed: 0.58 }
      ]) {
        const geo = new window.THREE.BufferGeometry();
        const positions = new Float32Array(layer.count * 3);
        const colors = new Float32Array(layer.count * 3);
        for (let i = 0; i < layer.count; i += 1) {
          const i3 = i * 3;
          positions[i3] = (Math.random() - 0.5) * layer.span;
          positions[i3 + 1] = (Math.random() - 0.5) * layer.span * 0.82;
          positions[i3 + 2] = (Math.random() - 0.5) * layer.depth - 180;
          const color = palette[Math.floor(Math.random() * palette.length)];
          colors[i3] = color[0]; colors[i3 + 1] = color[1]; colors[i3 + 2] = color[2];
        }
        geo.setAttribute('position', new window.THREE.BufferAttribute(positions, 3));
        geo.setAttribute('color', new window.THREE.BufferAttribute(colors, 3));
        const starMaterial = new window.THREE.PointsMaterial({
          size: layer.size, sizeAttenuation: true, vertexColors: true,
          transparent: true, opacity: 0, depthWrite: false, blending: window.THREE.AdditiveBlending
        });
        const points = new window.THREE.Points(geo, starMaterial);
        scene.add(points);
        starLayers.push({ geo, positions, material: starMaterial, points, speed: layer.speed, span: layer.span, depth: layer.depth });
      }

      // A handful of luminous streaks cross the field during the reveal.
      const streaks = [];
      const streakMaterial = new window.THREE.LineBasicMaterial({ color: 0xb9e8ff, transparent: true, opacity: 0, blending: window.THREE.AdditiveBlending });
      const streakGroup = new window.THREE.Group();
      scene.add(streakGroup);
      function launchStreak() {
        if (exited || document.hidden || streaks.length >= 3 || !splash.isConnected) return;
        const startX = (Math.random() - 0.5) * window.innerWidth * 1.4;
        const startY = (Math.random() - 0.5) * window.innerHeight * 0.8;
        const startZ = -Math.random() * 250;
        const points = [
          new window.THREE.Vector3(startX, startY, startZ),
          new window.THREE.Vector3(startX + 100 + Math.random() * 130, startY - 45 - Math.random() * 90, startZ + 5)
        ];
        const geometry = new window.THREE.BufferGeometry().setFromPoints(points);
        const line = new window.THREE.Line(geometry, streakMaterial.clone());
        line.material.opacity = 0.9;
        streakGroup.add(line);
        const streak = { line, geometry, age: 0, life: 35 + Math.random() * 22 };
        streaks.push(streak);
      }

      let rafId = 0;
      let exited = false;
      let frame = 0;
      function animate() {
        if (!splash.isConnected) return;
        rafId = window.requestAnimationFrame(animate);
        if (document.hidden) return;
        frame += 1;
        nebulaGroup.rotation.z = Math.sin(frame * 0.0007) * 0.045;
        nebulaGroup.position.x = Math.sin(frame * 0.0009) * 18;
        starLayers.forEach((layer) => {
          layer.points.rotation.z += layer.speed * 0.000035;
          const attribute = layer.geo.attributes.position;
          for (let i = 2; i < layer.positions.length; i += 3) {
            layer.positions[i] += layer.speed * 0.5;
            if (layer.positions[i] > 460) layer.positions[i] = -layer.depth - 180;
          }
          attribute.needsUpdate = true;
        });
        for (let i = streaks.length - 1; i >= 0; i -= 1) {
          const streak = streaks[i];
          streak.age += 1;
          const opacity = Math.max(0, 1 - streak.age / streak.life);
          streak.line.material.opacity = opacity;
          streak.line.position.x += 4.5;
          streak.line.position.y -= 3.1;
          if (streak.age > streak.life) {
            streakGroup.remove(streak.line);
            streak.geometry.dispose();
            streak.line.material.dispose();
            streaks.splice(i, 1);
          }
        }
        renderer.render(scene, camera);
      }
      function onResize() {
        camera.aspect = window.innerWidth / window.innerHeight;
        camera.updateProjectionMatrix();
        renderer.setSize(window.innerWidth, window.innerHeight);
      }
      function cleanup() {
        window.cancelAnimationFrame(rafId);
        window.removeEventListener('resize', onResize);
        starLayers.forEach((layer) => { layer.geo.dispose(); layer.material.dispose(); });
        nebulaSprites.forEach((sprite) => sprite.material.dispose());
        streaks.forEach((streak) => { streak.geometry.dispose(); streak.line.material.dispose(); });
        nebulaTexture.dispose();
        streakMaterial.dispose();
        renderer.dispose();
      }
      function exitSplash() {
        if (exited) return;
        exited = true;
        gsap.to('#welcome-overlay', { opacity: 0, duration: 0.95, ease: 'power2.inOut' });
        gsap.to('#welcome-mandala', { opacity: 0, duration: 0.9 });
        gsap.to('#welcome-progress-bar', { opacity: 0, duration: 0.5 });
        gsap.to('#welcome-skip-btn', { opacity: 0, duration: 0.4 });
        starLayers.forEach((layer) => gsap.to(layer.material, { opacity: 0.14, duration: 1.6, ease: 'power2.inOut' }));
        gsap.to('#welcome-splash', {
          opacity: 0, duration: 1.1, delay: 0.4, ease: 'power2.inOut',
          onComplete: () => { cleanup(); removeSplash(); }
        });
      }

      window.addEventListener('resize', onResize);
      animate();
      window.setTimeout(launchStreak, 1350);
      window.setTimeout(launchStreak, 2480);
      window.setTimeout(launchStreak, 3400);
      const timeline = gsap.timeline({ onComplete: exitSplash });
      nebulaSprites.forEach((sprite, index) => timeline.to(sprite.material, { opacity: 0.35 + (index % 3) * 0.06, duration: 2.4, ease: 'power2.out' }, 0.1 + index * 0.08));
      starLayers.forEach((layer, index) => timeline.to(layer.material, { opacity: index === 0 ? 0.8 : 0.95, duration: 1.6, ease: 'power1.inOut' }, 0.1 + index * 0.2));
      timeline.to('#welcome-progress-bar', { opacity: 1, duration: 0.5 }, 0.35);
      timeline.to('#welcome-progress-fill', { width: '100%', duration: 5.4, ease: 'none' }, 0.4);
      timeline.to('#welcome-mandala', { opacity: 1, duration: 1.5, ease: 'power2.inOut' }, 1.0);
      timeline.to('#welcome-cosmic-form', { opacity: 1, scale: 1.06, y: 0, duration: 1.35, ease: 'power4.out' }, 1.25);
      timeline.to('.welcome-aura-ring', { scale: 1, duration: 1.05, stagger: 0.25, ease: 'back.out(1.4)', transformOrigin: 'center center' }, 1.65);
      timeline.to('#welcome-sanskrit', { opacity: 1, y: 0, duration: 0.65, ease: 'power2.out' }, 2.35);
      timeline.to('#welcome-name', { opacity: 1, duration: 0.8, ease: 'power3.out' }, 2.8);
      timeline.to('#welcome-divider', { opacity: 1, width: 260, duration: 0.65, ease: 'power2.inOut' }, 3.1);
      timeline.to('#welcome-role', { opacity: 1, duration: 0.55, ease: 'power2.out' }, 3.4);
      timeline.to('#welcome-tagline', { opacity: 1, duration: 0.5, ease: 'power2.out' }, 3.75);
      timeline.to('#welcome-skip-btn', { opacity: 1, duration: 0.4 }, 0.65);
      timeline.to({}, { duration: 1.6 });
      gsap.set('#welcome-cosmic-form', { y: 30 });
      gsap.set('#welcome-sanskrit', { y: 8 });
      gsap.set('.welcome-aura-ring', { scale: 0, transformOrigin: 'center center' });
      document.getElementById('welcome-skip-btn')?.addEventListener('click', () => {
        timeline.kill();
        exitSplash();
      }, { once: true });
    } catch (error) {
      console.warn('Intro animation failed; continuing to the portfolio.', error);
      body.classList.remove('welcome-lock');
      splash.remove();
      try { renderer.dispose(); } catch {}
    }
  })();
</script>

