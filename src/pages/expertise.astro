---
import BaseLayout from '../layouts/BaseLayout.astro';
import { pillarPages } from '../data/seo';
---

<BaseLayout title="Expertise & Technical Domains | Vinod M" description="Explore Vinod M's work across business systems, data analytics, workflow automation, software engineering, and applied AI.">
  <main class="expertise-page">
    <div class="expertise-wrap">
      <header class="expertise-hero">
        <p class="expertise-eyebrow">AREAS OF PRACTICE</p>
        <h1>Explore the disciplines<br/><span>behind the work.</span></h1>
        <p>My work crosses business context, data, software, and applied AI. These topic pages explain the concepts I work with and connect them to relevant projects, research, and practical implementation.</p>
      </header>

      <section class="expertise-grid" aria-label="Technical domains">
        {pillarPages.map((pillar, index) => (
          <a href={`/${pillar.slug}`} class="expertise-card">
            <span class="expertise-card-number">{String(index + 1).padStart(2, '0')} / DOMAIN</span>
            <h2>{pillar.title}</h2>
            <p>{pillar.subtitle}</p>
            <span class="expertise-card-link">Explore domain <span aria-hidden="true">↗</span></span>
          </a>
        ))}
      </section>

      <section class="expertise-method">
        <p class="expertise-eyebrow">HOW I WORK</p>
        <h2>Understand first.<br/><span>Build with evidence.</span></h2>
        <div class="expertise-method-grid">
          <article><span>01</span><h3>Understand the problem</h3><p>Clarify the user, the decision or task, the constraints, and what success should look like.</p></article>
          <article><span>02</span><h3>Design the system</h3><p>Connect process, data, software, and people instead of choosing a tool before the problem is clear.</p></article>
          <article><span>03</span><h3>Validate the outcome</h3><p>Test assumptions, check edge cases, document limitations, and improve what proves useful.</p></article>
        </div>
        <div class="expertise-actions">
          <a href="/featured">View selected projects ↗</a>
          <a href="/#contact">Discuss a problem →</a>
        </div>
      </section>
    </div>
  </main>
  <style>
    .expertise-page{min-height:100vh;padding:clamp(112px,14vw,155px) 21px 80px;color:#ecebe3;background:radial-gradient(ellipse at 73% 7%,rgba(41,83,94,.14),transparent 35%),linear-gradient(180deg,#080d14 0%,#0a1118 100%)}
    .expertise-wrap{max-width:1180px;margin:0 auto}.expertise-hero{max-width:850px;margin:0 auto 48px;text-align:center}.expertise-eyebrow{color:#82c9ce;font:600 .65rem/1.7 Inter,system-ui,sans-serif;letter-spacing:.23em}.expertise-hero h1{margin-top:16px;color:#efe8d8;font:650 clamp(2.5rem,6vw,4.7rem)/1.04 Inter,system-ui,sans-serif;letter-spacing:-.06em}.expertise-hero h1 span,.expertise-method h2 span{background:linear-gradient(110deg,#f0dfae,#c9a95d 55%,#81cdd1);-webkit-background-clip:text;background-clip:text;color:transparent}.expertise-hero>p:last-child{max-width:760px;margin:21px auto 0;color:#aab8b9;font-size:1rem;line-height:1.85}
    .expertise-grid{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:14px}.expertise-card{display:flex;flex-direction:column;min-width:0;min-height:225px;padding:24px;text-decoration:none;background:#0d151d;border:1px solid #c9a95d26;transition:border-color .2s,background .2s}.expertise-card:hover{border-color:#c9a95d73;background:#101a22}.expertise-card-number{color:#80cbd0;font:600 .58rem/1.7 Inter,system-ui,sans-serif;letter-spacing:.15em}.expertise-card h2{margin-top:17px;color:#e8d7a7;font:600 1.27rem/1.32 Inter,system-ui,sans-serif;letter-spacing:-.025em}.expertise-card>p{margin-top:10px;color:#a2b1b2;font-size:.85rem;line-height:1.75}.expertise-card-link{display:flex;justify-content:space-between;align-items:center;gap:8px;margin-top:auto;padding-top:20px;color:#d6c27f;font-size:.78rem;font-weight:600}
    .expertise-method{margin-top:58px;padding-top:34px;border-top:1px solid #ffffff19}.expertise-method h2{margin-top:13px;color:#eee7d7;font:600 clamp(2rem,4.5vw,3.35rem)/1.08 Inter,system-ui,sans-serif;letter-spacing:-.05em}.expertise-method-grid{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:14px;margin-top:28px}.expertise-method-grid article{padding:21px 19px;background:#0b131a;border:1px solid #81cdd11b}.expertise-method-grid article>span{color:#c9a95d;font:600 .61rem Inter,system-ui,sans-serif;letter-spacing:.12em}.expertise-method-grid h3{margin-top:11px;color:#e2d8bd;font-size:.93rem;line-height:1.5}.expertise-method-grid p{margin-top:8px;color:#9babad;font-size:.81rem;line-height:1.75}.expertise-actions{display:flex;gap:24px;flex-wrap:wrap;margin-top:28px}.expertise-actions a{color:#80cbd0;font-size:.84rem;font-weight:600;text-decoration:none}.expertise-actions a:hover{color:#f0dfae;text-decoration:underline;text-underline-offset:4px}
    @media(max-width:850px){.expertise-grid{grid-template-columns:repeat(2,minmax(0,1fr))}.expertise-method-grid{grid-template-columns:1fr}}@media(max-width:560px){.expertise-page{padding:104px 17px 55px}.expertise-hero h1{font-size:clamp(2.35rem,11vw,3.4rem)}.expertise-grid{grid-template-columns:1fr}.expertise-card{min-height:0;padding:21px}.expertise-method{margin-top:39px;padding-top:26px}.expertise-actions{gap:18px}}
  </style>
</BaseLayout>
