---
import { completedProjects, ongoingProjects } from '../../data/projects';
import { socialLinks } from '../../data/social-links';
const totalProjects = completedProjects.length + ongoingProjects.length;
---

<section id="about" class="profile-section relative z-10 px-6 py-24 md:py-32">
  <div class="mx-auto max-w-7xl">
    <div class="profile-heading">
      <p class="profile-eyebrow">THE PERSON BEHIND THE SYSTEMS</p>
      <h2>Curiosity, translated<br/><span>into useful work.</span></h2>
      <p>Not technology for its own sake. Tools, workflows, and intelligence that help people make better decisions.</p>
    </div>
    <div class="profile-grid mt-14">
      <article class="profile-card profile-identity">
        <div class="profile-photo-wrap"><img src="/images/profile.jpg" alt="Vinod M, data analytics and AI practitioner based in Mysuru" loading="lazy" decoding="async"/></div>
        <p class="profile-name">Vinod M</p>
        <p class="profile-role">Analytics · Automation · Applied AI</p>
        <div class="profile-tags"><span>Mysuru, India</span><span>MCA · Computer Science</span></div>
        <div class="profile-links">
          <a href={socialLinks.github} target="_blank" rel="noopener noreferrer">GitHub ↗</a>
          <a href={socialLinks.linkedin} target="_blank" rel="noopener noreferrer">LinkedIn ↗</a>
        </div>
      </article>
      <div class="profile-story">
        <p class="profile-kicker">MY WORKING PRINCIPLE</p>
        <h3>Make the complex<br/>clear. Make the useful<br/><em>real.</em></h3>
        <p>I enjoy taking an unclear problem—from scattered spreadsheets and manual reporting to model outputs or product ideas—and shaping it into a workflow people can actually understand and use.</p>
        <p>My work spans MIS and KPI reporting, business intelligence, Python-based automation, computer vision, NLP, and practical AI prototypes. I care about the details behind a result: data quality, repeatability, a clear interface, and whether the solution improves the way a team works.</p>
        <div class="profile-pillars">
          <div><span>01</span><strong>Understand</strong><p>Find the real problem before choosing the tool.</p></div>
          <div><span>02</span><strong>Build</strong><p>Design a simple, reliable workflow around it.</p></div>
          <div><span>03</span><strong>Improve</strong><p>Validate the result and make it easier to maintain.</p></div>
        </div>
        <div class="profile-proof-strip">
          <div><strong>{totalProjects}+</strong><span>Projects & prototypes</span></div>
          <div><strong>1</strong><span>Research publication</span></div>
          <div><strong>SQL · Python · BI</strong><span>Core delivery toolkit</span></div>
        </div>
        <div class="profile-next-step"><span class="profile-next-dot"></span><p><strong>Open to meaningful work</strong><br/>Data analytics, MIS, business intelligence, automation, and applied AI opportunities.</p><a href="/#contact" aria-label="Contact Vinod M">Let’s talk ↗</a></div>
      </div>
    </div>
  </div>
</section>

<style>
  .profile-section{background:linear-gradient(180deg,#080d12 0%,#091117 100%);color:#f2f0e7}
  .profile-heading{max-width:780px}.profile-eyebrow,.profile-kicker{font-size:.7rem;letter-spacing:.24em;color:#ceb678;font-weight:700}.profile-heading h2{margin-top:18px;font-size:clamp(2.5rem,5.2vw,4.8rem);font-weight:650;letter-spacing:-.055em;line-height:1.02}.profile-heading h2 span{color:transparent;background:linear-gradient(105deg,#f2dda7,#c4a258 55%,#78d1d6);background-clip:text;-webkit-background-clip:text}.profile-heading>p:last-child{margin-top:22px;color:#aab6b7;max-width:650px;font-size:1.08rem;line-height:1.8}
  .profile-grid{display:grid;grid-template-columns:minmax(260px,.72fr) minmax(0,1.5fr);gap:clamp(28px,6vw,84px);align-items:start}
  .profile-card{position:relative;overflow:hidden;border:1px solid #d8c58a2c;background:linear-gradient(155deg,#122027,#0b1116 75%);padding:32px;border-radius:6px;box-shadow:0 25px 90px #0005}.profile-card:before{content:"";position:absolute;top:0;left:0;width:100%;height:2px;background:linear-gradient(90deg,#d7b96b,#6acbd1,transparent)}
  .profile-photo-wrap{width:100%;aspect-ratio:4/4.7;border-radius:4px;overflow:hidden;background:radial-gradient(circle at 50% 40%,#24414a,#0b1116 72%);border:1px solid #ffffff20}.profile-photo-wrap img{width:100%;height:100%;object-fit:cover;object-position:center 25%;filter:saturate(.86);transition:transform .7s}.profile-card:hover .profile-photo-wrap img{transform:scale(1.035)}
  .profile-name{font-size:2rem;font-weight:700;letter-spacing:-.04em;margin-top:23px}.profile-role{margin-top:5px;color:#9db4b5;font-size:.9rem;line-height:1.6}.profile-tags{display:grid;gap:9px;margin-top:22px}.profile-tags span{font-size:.76rem;color:#d3d2c8;padding:8px 10px;border:1px solid #ffffff19;background:#ffffff05}.profile-links{display:flex;gap:18px;margin-top:26px;padding-top:20px;border-top:1px solid #ffffff1a}.profile-links a{font-size:.8rem;color:#dec988}.profile-links a:hover{color:#fff}
  .profile-story{padding-top:5px}.profile-story h3{font-size:clamp(2.5rem,4vw,4rem);line-height:1.03;letter-spacing:-.05em;font-weight:600;margin-top:17px}.profile-story h3 em{font-family:Georgia,serif;font-weight:400;color:#d8b96e}.profile-story>p:not(.profile-kicker){font-size:1rem;line-height:1.85;color:#aebabb;max-width:760px;margin-top:20px}
  .profile-pillars{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:12px;margin-top:32px}.profile-pillars>div{padding:18px 15px;border-top:1px solid #d5b96d70;background:linear-gradient(180deg,#ffffff08,transparent)}.profile-pillars span{display:block;font-size:.66rem;letter-spacing:.14em;color:#6bcbd1}.profile-pillars strong{display:block;font-size:1rem;margin-top:14px;color:#f0e5c4}.profile-pillars p{font-size:.8rem;line-height:1.65;color:#8fa1a3;margin-top:8px}
  .profile-proof-strip{display:grid;grid-template-columns:1fr 1fr 1.5fr;gap:18px;margin-top:34px;padding:24px 0;border-top:1px solid #ffffff1c;border-bottom:1px solid #ffffff1c}.profile-proof-strip div{display:grid;gap:7px}.profile-proof-strip strong{font-size:1.35rem;color:#e5cd8f}.profile-proof-strip span{font-size:.73rem;color:#94a5a6;line-height:1.5}
  .profile-next-step{display:flex;align-items:center;gap:14px;margin-top:28px;padding:17px 18px;border:1px solid #8ccfd12d;background:#10212680}.profile-next-dot{flex:none;width:8px;height:8px;background:#8fdcb8;border-radius:50%;box-shadow:0 0 14px #8fdcb8}.profile-next-step p{font-size:.82rem;line-height:1.65;color:#9fb1b2;flex:1}.profile-next-step p strong{color:#eee5cb}.profile-next-step>a{white-space:nowrap;font-size:.8rem;color:#e2c77e}
  @media(max-width:800px){.profile-grid{grid-template-columns:1fr}.profile-card{max-width:470px;width:100%;margin:0 auto}.profile-photo-wrap{max-height:480px}.profile-story{padding-top:16px}}
  @media(max-width:520px){.profile-section{padding-left:20px;padding-right:20px}.profile-card{padding:22px}.profile-pillars{grid-template-columns:1fr}.profile-pillars>div{padding:15px}.profile-pillars strong{margin-top:7px}.profile-proof-strip{grid-template-columns:1fr 1fr}.profile-proof-strip div:last-child{grid-column:1/-1}.profile-next-step{align-items:flex-start;flex-wrap:wrap}.profile-next-step>a{margin-left:22px}}
  @media(prefers-reduced-motion:reduce){.profile-photo-wrap img{transition:none}}
</style>
