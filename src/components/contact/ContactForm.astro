---
import { socialLinks } from '../../data/social-links';
---

<section id="contact" class="py-32 px-6 relative z-10 bg-gradient-to-b from-slate-900 to-black/50 border-t border-white/5">
  <div class="max-w-4xl mx-auto">
    <div class="text-center mb-24">
      <h2 class="text-5xl md:text-6xl font-black gradient-text mb-6">Let's Connect</h2>
      <p class="text-xl md:text-2xl text-white/80 max-w-2xl mx-auto leading-relaxed mb-8">Open to <span class="gradient-text font-semibold">Data Analyst, BI, AI, and Software roles</span> where I can contribute with practical work.</p>
      <div class="w-24 h-1 mx-auto bg-gradient-to-r from-amber-300 to-cyan-300 rounded-full"></div>
    </div>
    <div class="grid lg:grid-cols-2 gap-16 items-start">
      <div><div class="glass rounded-4xl p-10 md:p-12 shadow-2xl shadow-black/30 border-white/10 backdrop-blur-xl">
        <h3 class="text-3xl font-bold gradient-text mb-8 text-center">Send Me a Message</h3>
        <p class="text-white/70 text-sm mb-6 leading-relaxed">This form opens your email application with your message prepared. Review it and press Send to deliver it.</p>
        <form class="space-y-6" id="contact-form" data-contact-email={socialLinks.email}>
          <div><label for="contact-name" class="block text-white/90 font-semibold mb-3">Full Name</label><input id="contact-name" type="text" name="name" required autocomplete="name" class="w-full glass px-6 py-4 rounded-2xl text-white/90 placeholder-white/50 border border-white/20 focus:border-[#c9a95d] focus:outline-none focus:shadow-black/30 transition-all duration-300 text-lg" placeholder="Your full name" /></div>
          <div><label for="contact-email" class="block text-white/90 font-semibold mb-3">Email Address</label><input id="contact-email" type="email" name="email" required autocomplete="email" class="w-full glass px-6 py-4 rounded-2xl text-white/90 placeholder-white/50 border border-white/20 focus:border-[#c9a95d] focus:outline-none focus:shadow-black/30 transition-all duration-300 text-lg" placeholder="your-email@example.com" /></div>
          <div><label for="contact-message" class="block text-white/90 font-semibold mb-3">Message</label><textarea id="contact-message" name="message" rows="5" required class="w-full glass px-6 py-4 rounded-2xl text-white/90 placeholder-white/50 border border-white/20 focus:border-[#c9a95d] focus:outline-none focus:shadow-black/30 transition-all duration-300 resize-vertical text-lg" placeholder="Tell me what you’re building and where you need help..."></textarea></div>
          <button type="submit" class="w-full gradient-border glass px-8 py-6 rounded-3xl text-xl font-bold text-white hover:scale-[1.02] hover:shadow-[0_0_60px_rgba(102,126,234,0.35)] transition-all duration-300 shadow-2xl">Prepare Email <svg class="inline ml-2 w-6 h-6" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M12 19l9 2-9-18-9 18 9-2zm0 0v-8"></path></svg></button>
        </form>
        <p id="form-status" class="hidden mt-6 p-5 rounded-2xl border border-cyan-300/30 bg-cyan-500/10 text-cyan-100 text-sm leading-relaxed" role="status" aria-live="polite"></p>
      </div></div>
      <div class="space-y-8"><div class="glass rounded-3xl p-8 md:p-10 shadow-2xl shadow-black/20 border-white/10 backdrop-blur-xl">
        <h3 class="text-2xl font-bold gradient-text mb-8 text-center">Contact details</h3><div class="space-y-6">
          <div class="flex items-center space-x-4 p-4 glass rounded-2xl border-l-4 border-[#c9a95d] hover:bg-white/10 transition-all duration-300"><div class="w-12 h-12 glass rounded-xl flex items-center justify-center text-2xl shadow-md" aria-hidden="true">✉️</div><div><p class="text-white/80 font-semibold text-sm uppercase tracking-wide">Email</p><a href={`mailto:${socialLinks.email}`} class="text-lg font-bold gradient-text hover:text-[#e0c887] transition-colors">{socialLinks.email}</a></div></div>
          <div class="flex items-center space-x-4 p-4 glass rounded-2xl border-l-4 border-[#81cdd1] hover:bg-white/10 transition-all duration-300"><div class="w-12 h-12 glass rounded-xl flex items-center justify-center text-2xl shadow-md" aria-hidden="true">💻</div><div><p class="text-white/80 font-semibold text-sm uppercase tracking-wide">GitHub</p><a href={socialLinks.github} target="_blank" rel="noopener noreferrer" class="text-lg font-bold gradient-text hover:text-[#81cdd1] transition-colors">github.com/Vinodvinum</a></div></div>
          <div class="flex items-center space-x-4 p-4 glass rounded-2xl border-l-4 border-[#c9a95d] hover:bg-white/10 transition-all duration-300"><div class="w-12 h-12 glass rounded-xl flex items-center justify-center text-2xl shadow-md" aria-hidden="true">💼</div><div><p class="text-white/80 font-semibold text-sm uppercase tracking-wide">LinkedIn</p><a href={socialLinks.linkedin} target="_blank" rel="noopener noreferrer" class="text-lg font-bold gradient-text hover:text-[#81cdd1] transition-colors">linkedin.com/in/vinod-m-b830061ba</a></div></div>
          <div class="flex items-center space-x-4 p-4 glass rounded-2xl border-l-4 border-[#81cdd1] hover:bg-white/10 transition-all duration-300"><div class="w-12 h-12 glass rounded-xl flex items-center justify-center text-2xl shadow-md" aria-hidden="true">📱</div><div><p class="text-white/80 font-semibold text-sm uppercase tracking-wide">WhatsApp</p><a href={`https://wa.me/${socialLinks.whatsapp}`} target="_blank" rel="noopener noreferrer" class="text-lg font-bold text-[#81cdd1] hover:text-[#b7e7e8] transition-colors">WhatsApp message</a></div></div>
        </div></div></div>
    </div>
  </div>
</section>

<script>
  function initPortfolioContactForm() {
    const form = document.getElementById('contact-form') as HTMLFormElement | null;
    const status = document.getElementById('form-status') as HTMLParagraphElement | null;
    if (!form || form.dataset.mailtoHandlerAttached) return;
    form.dataset.mailtoHandlerAttached = 'true';
    form.addEventListener('submit', (event) => {
      event.preventDefault();
      const data = new FormData(form);
      const name = String(data.get('name') ?? '').trim();
      const email = String(data.get('email') ?? '').trim();
      const message = String(data.get('message') ?? '').trim();
      if (!name || !email || !message) {
        status?.classList.remove('hidden');
        if (status) status.textContent = 'Please complete all fields before preparing your email.';
        return;
      }
      const emailAddress = form.dataset.contactEmail;
      if (!emailAddress) {
        status?.classList.remove('hidden');
        if (status) status.textContent = 'The email address is unavailable. Please use the contact details shown on this page.';
        return;
      }
      const subject = encodeURIComponent(`Portfolio contact from ${name}`);
      const body = encodeURIComponent(`Name: ${name}\nReply email: ${email}\n\nMessage:\n${message}`);
      if (status) {
        status.classList.remove('hidden');
        status.textContent = 'Your email application should open with the message prepared. Review it and press Send. If it does not open, use the email address shown on this page.';
      }
      window.location.href = `mailto:${emailAddress}?subject=${subject}&body=${body}`;
    });
  }
  initPortfolioContactForm();
  document.addEventListener('astro:page-load', initPortfolioContactForm);
</script>
