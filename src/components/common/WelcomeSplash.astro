  .intro-wheel-rotor { transform-origin: 250px 250px; animation: introWheelSpin 42s linear infinite; }\n  @keyframes introWheelSpin { to { transform: rotate(360deg); } }\n  @keyframes welcomeAuraPulse { 0%,100% { filter: drop-shadow(0 0 18px rgba(201,168,76,0.8)) drop-shadow(0 0 45px rgba(77,217,232,0.35)) drop-shadow(0 0 80px rgba(201,168,76,0.3)); } 50% { filter: drop-shadow(0 0 30px rgba(201,168,76,1)) drop-shadow(0 0 70px rgba(77,217,232,0.6)) drop-shadow(0 0 120px rgba(155,109,255,0.4)); } }
