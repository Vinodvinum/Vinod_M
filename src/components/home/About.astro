---
import { completedProjects, ongoingProjects } from '../../data/projects';
import { socialLinks } from '../../data/social-links';
const totalProjects = completedProjects.length + ongoingProjects.length;
---

<section id="about" class="profile-section">
  <div class="profile-container">
    <header class="profile-heading">
      <p class="section-eyebrow">THE PERSON BEHIND THE SYSTEMS</p>
      <h2>One mind. Many disciplines.<br/><span>One direction: impact.</span></h2>
      <p>I’m not defined by a list of tools. I’m defined by how I connect business context, data, engineering, and people to solve the problem that actually matters.</p>
    </header>

    <div class="profile-grid">
      <aside class="profile-card">
        <div class="profile-photo"><img src="/images/profile.jpg" alt="Vinod M, business systems developer and applied AI practitioner in Mysuru" loading="lazy" decoding="async"/></div>
        <p class="profile-name">Vinod M</p>
        <p class="profile-role">Business Systems · Automation · Applied AI</p>
        <p class="profile-card-summary">From understanding a business need to shaping a workflow, building the system, and checking whether it creates value.</p>
        <div class="profile-affiliations"><p><span>NOW</span> GRS Fantasy Park · MIS &amp; Business System Developer</p><p><span>ALSO</span> Individual work · Medhaksha Technologies<br/><a href="https://medhakshatech.in/" target="_blank" rel="noopener noreferrer" class="profile-affiliation-link">medhakshatech.in ↗</a></p><p><span>EDUCATION</span> MCA · Computer Science</p></div>
        <div class="profile-links"><a href={socialLinks.github} target="_blank" rel="noopener noreferrer">GitHub ↗</a><a href={socialLinks.linkedin} target="_blank" rel="noopener noreferrer">LinkedIn ↗</a></div>
      </aside>

      <div class="profile-story">
        <p class="section-eyebrow">MY PROFESSIONAL STORY</p>
        <h3>Think in systems.<br/>Build with purpose.<br/><em>Deliver with ownership.</em></h3>
        <p>My work moves between business requirements, operational processes, data, reporting and software. I start by understanding the people, constraints and decisions around a problem; then I map the process, validate the data, and build a practical solution that a team can use and maintain.</p>
        <p>At GRS Fantasy Park, I work across MIS and business systems, process engineering, FMS and checklist monitoring, operational reporting, workflow automation, and internal application development. The aim is to make ownership clearer, information more reliable, and day-to-day execution easier to follow.</p>
        <p>Through my individual work with Medhaksha Technologies, I contribute to automation, applied AI, and practical technology solutions. <a href="https://medhakshatech.in/" target="_blank" rel="noopener noreferrer" class="story-inline-link">Explore Medhaksha Technologies ↗</a> My project work also includes business workflows, computer vision, NLP, document intelligence and deployed software prototypes. I value clear validation and maintainability as much as the initial build.</p>

        <div class="profile-method">
          <article><span>01 / UNDERSTAND</span><h4>Find the real problem</h4><p>Clarify the business need, users, data, and constraints before choosing a tool.</p></article>
          <article><span>02 / BUILD</span><h4>Design a useful system</h4><p>Connect process, data, validation, automation, and decision-ready reporting.</p></article>
          <article><span>03 / IMPROVE</span><h4>Make it dependable</h4><p>Check outcomes, close gaps, reduce repeat work, and support the people using it.</p></article>
        </div>
        <div class="profile-proof"><div><strong>{totalProjects}+</strong><span>Projects & prototypes</span></div><div><strong>Ideas → Systems</strong><span>My working intersection</span></div><div><strong>MCA</strong><span>Computer Science</span></div></div>
        <div class="profile-open"><span class="availability-dot" aria-hidden="true"></span><p><strong>Open to meaningful work</strong><br/>Business systems, MIS, workflow automation, and applied AI opportunities.</p><a href="/#contact">Let’s talk ↗</a></div>
      </div>
    </div>
  </div>
</section>

<style>
  .profile-section{position:relative;z-index:1;padding:clamp(65px,8vw,110px) 22px;color:#ecebe3;background:linear-gradient(180deg,#090d14 0%,#0a1118 100%);border-top:1px solid #ffffff0d}
  .profile-container{max-width:1180px;margin:0 auto}.section-eyebrow{color:#c7ad69;font:600 .67rem/1.7 Inter,system-ui,sans-serif;letter-spacing:.22em}
  .profile-heading{max-width:850px}.profile-heading h2{margin-top:16px;font:600 clamp(2.35rem,5.3vw,4.55rem)/1.04 Inter,system-ui,sans-serif;letter-spacing:-.055em}.profile-heading h2 span{color:#ddc27e}.profile-heading>p:last-child{max-width:760px;margin-top:18px;color:#a9b5b6;font-size:1.02rem;line-height:1.8}
  .profile-grid{display:grid;grid-template-columns:minmax(260px,.75fr) minmax(0,1.45fr);align-items:start;gap:clamp(28px,6vw,76px);margin-top:46px}
  .profile-card{padding:27px;background:#0d151d;border:1px solid #c9a95d2d;box-shadow:0 18px 55px #0002}
  .profile-photo{overflow:hidden;aspect-ratio:4/4.4;background:#111b23;border:1px solid #ffffff17}.profile-photo img{width:100%;height:100%;object-fit:cover;object-position:center 25%;display:block;filter:saturate(.88)}
  .profile-name{margin-top:22px;font:650 2rem/1.15 Inter,system-ui,sans-serif;letter-spacing:-.045em;color:#f3f0e6}.profile-role{margin-top:7px;font-size:.86rem;line-height:1.7;color:#d9c487}.profile-card-summary{margin-top:15px;font-size:.89rem;line-height:1.8;color:#aab7b8}
  .profile-affiliations{display:grid;gap:10px;margin-top:23px}.profile-affiliations p{display:grid;gap:5px;padding-top:10px;border-top:1px solid #ffffff14;color:#ced6d1;font-size:.79rem;line-height:1.65}.profile-affiliations span{font:600 .59rem Inter,system-ui,sans-serif;letter-spacing:.15em;color:#7fc8cb}.profile-affiliation-link,.story-inline-link{color:#dfc783;text-decoration:underline;text-decoration-color:#dfc78355;text-underline-offset:3px}.profile-affiliation-link{font-size:.75rem}.story-inline-link{white-space:nowrap}
  .profile-links{display:flex;gap:20px;margin-top:23px;padding-top:18px;border-top:1px solid #ffffff17}.profile-links a{font-size:.8rem;color:#e0c887}.profile-links a:hover{color:#fff0c5}
  .profile-story h3{margin-top:14px;font:600 clamp(2.15rem,4.2vw,3.85rem)/1.05 Inter,system-ui,sans-serif;letter-spacing:-.055em}.profile-story h3 em{font-family:'Cormorant Garamond',Georgia,serif;font-weight:500;color:#ddc27e}.profile-story>p:not(.section-eyebrow){max-width:780px;margin-top:18px;color:#aab7b8;font-size:.97rem;line-height:1.9}
  .profile-method{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:15px;margin-top:30px}.profile-method article{padding:18px 14px 15px;border-top:1px solid #c7ad6970;background:linear-gradient(180deg,#ffffff05,transparent)}.profile-method article>span{font:600 .58rem/1.7 Inter,system-ui,sans-serif;letter-spacing:.1em;color:#80cbd0}.profile-method h4{margin-top:12px;color:#ede3c7;font-size:.92rem;line-height:1.5}.profile-method p{margin-top:7px;color:#91a3a4;font-size:.77rem;line-height:1.75}
  .profile-proof{display:grid;grid-template-columns:1fr 1.4fr 1fr;gap:20px;margin-top:30px;padding:22px 0;border-top:1px solid #ffffff18;border-bottom:1px solid #ffffff18}.profile-proof div{display:grid;gap:6px}.profile-proof strong{font-size:1.1rem;line-height:1.4;color:#e0c887}.profile-proof span{font-size:.7rem;line-height:1.55;color:#91a3a4}
  .profile-open{display:flex;align-items:center;gap:13px;margin-top:25px;padding:17px 15px;border:1px solid #80cbd026;background:#0c191d}.availability-dot{flex:none;width:7px;height:7px;border-radius:50%;background:#8dcfb2}.profile-open p{flex:1;color:#9eafae;font-size:.8rem;line-height:1.75}.profile-open p strong{color:#eee3c8}.profile-open a{white-space:nowrap;color:#e0c887;font-size:.78rem}
  @media(max-width:850px){.profile-grid{grid-template-columns:1fr}.profile-card{max-width:510px;width:100%;margin:0 auto}.profile-photo{max-height:500px}.profile-story{padding-top:4px}}
  @media(max-width:600px){.profile-section{padding:60px 19px}.profile-grid{margin-top:30px;gap:32px}.profile-card{padding:20px}.profile-name{font-size:1.8rem}.profile-story h3{font-size:clamp(2rem,9.5vw,3rem)}.profile-method{grid-template-columns:1fr;gap:9px}.profile-method article{padding:15px 13px}.profile-method h4{margin-top:6px}.profile-proof{grid-template-columns:1fr 1fr;gap:14px}.profile-proof div:nth-child(2){grid-column:1/-1;grid-row:2}.profile-open{align-items:flex-start;flex-wrap:wrap}.profile-open a{margin-left:20px}}
</style>