  <button id="welcome-skip-btn" class="splash-skip" type="button">Skip intro <span aria-hidden="true">↗</span></button>
</div>

<script is:inline>
  (() => {
    const splash = document.getElementById('welcome-splash');
    if (!splash || splash.dataset.started === 'true') return;
    splash.dataset.started = 'true';
    const body = document.body;
    body.classList.add('welcome-lock');
    let closed = false;
    const timers = [];
    const closeIntro = () => {
      if (closed) return;
      closed = true;
      timers.forEach(window.clearTimeout);
      splash.classList.add('is-leaving');
      body.classList.remove('welcome-lock');
      window.setTimeout(() => splash.remove(), 850);
    };
    const reduceMotion = window.matchMedia?.('(prefers-reduced-motion: reduce)').matches;
    if (reduceMotion) {
      closeIntro();
      return;
    }
    const later = (fn, ms) => timers.push(window.setTimeout(fn, ms));
    splash.dataset.phase = '0';
    // Keep a clear INITIALIZING beat before revealing the mandala and name.
    later(() => { splash.dataset.phase = '1'; }, 1050);
    later(() => { splash.dataset.phase = '2'; }, 1700);
    later(() => { splash.dataset.phase = '3'; }, 2750);
    later(() => { splash.dataset.phase = '4'; }, 3850);
    later(() => { splash.dataset.phase = '5'; }, 4950);
    later(() => { splash.dataset.phase = '6'; }, 5850);
    later(closeIntro, 7600);
    document.getElementById('welcome-skip-btn')?.addEventListener('click', closeIntro, { once: true });
    // Hard timeout prevents an intro from ever trapping the page.
    later(closeIntro, 8000);
  })();
</script>

