---
import BaseLayout from '../layouts/BaseLayout.astro';
import { buildProjectSchema } from '../utils/seo';

const projectSchemas = [
  buildProjectSchema({
    name: 'Financial Reporting Dashboard',
    description: 'An interactive Streamlit portfolio demonstration organizing financial measures, trends, and filters for review.',
    url: 'https://aifinancialdashboard.streamlit.app/',
    sameAs: ['https://github.com/Vinodvinum/Financial_dashboard'],
  }),

  buildProjectSchema({
    name: 'GRS Operations Dashboard (Demo)',
    description: 'A portfolio demonstration using synthetic sample data for operational metrics, trends, filtering, and forecasting. It is not connected to production systems.',
    url: 'https://grsdashboard.streamlit.app/',
    sameAs: ['https://github.com/Vinodvinum/GRS_Dashboard'],
  }),
];
---

<BaseLayout title="Featured Projects | Vinod M" description="Selected software, automation, and applied AI project demonstrations by Vinod M." extraSchemas={projectSchemas}>
  <section class="min-h-screen pt-40 pb-20 px-6 relative z-10">
    <div class="max-w-6xl mx-auto">
      <div class="text-center mb-20">
        <h1 class="text-5xl md:text-7xl font-black gradient-text mb-6">Featured Projects</h1>
        <p class="text-xl md:text-2xl text-white/80 max-w-3xl mx-auto leading-relaxed">
          Selected software, automation, and applied AI project demonstrations.
        </p>
        <div class="w-24 h-1 mx-auto mt-8 bg-gradient-to-r from-purple-400 to-pink-400 rounded-full"></div>
      </div>

      <article class="mb-24 glass rounded-3xl p-8 md:p-12 border-white/10">
        <div class="grid md:grid-cols-2 gap-12 items-center">
          <div>
            <h2 class="text-4xl md:text-5xl font-black gradient-text mb-4">Financial Reporting Dashboard</h2>
            <p class="text-lg text-white/80 mb-6">A Streamlit reporting demonstration organizing financial measures, trends, and filters using demonstration data.</p>
            <div class="space-y-6 mb-8">
              <div><h3 class="text-white font-bold mb-2">Goal</h3><p class="text-white/70">Make financial measures and trends easier to review in one interface.</p></div>
              <div><h3 class="text-white font-bold mb-2">Implementation</h3><p class="text-white/70">Python, Pandas, and Streamlit present KPI cards, trend charts, and drill-down tables. Treat this deployment as a portfolio demonstration, not an authenticated production finance system.</p></div>
              <div><h3 class="text-white font-bold mb-2">What it demonstrates</h3><ul class="text-white/70 space-y-2"><li>✓ KPI summaries and trend visualization</li><li>✓ Filtering and interactive exploration</li><li>✓ A deployable analytics interface</li></ul></div>
              <div class="glass p-6 rounded-2xl border-emerald-300/30 bg-emerald-500/10"><h3 class="text-emerald-100 font-bold mb-3">Tech Stack</h3><p class="text-emerald-100/80">Python • Pandas • Streamlit • Plotly</p></div>
            </div>
            <div class="flex gap-4"><a href="https://aifinancialdashboard.streamlit.app/" target="_blank" rel="noopener noreferrer" class="gradient-border glass px-6 py-3 rounded-2xl font-semibold hover:scale-105 transition-all">Live Demo</a><a href="https://github.com/Vinodvinum/Financial_dashboard" target="_blank" rel="noopener noreferrer" class="glass px-6 py-3 rounded-2xl font-semibold border border-white/30 hover:scale-105 transition-all">View Source</a></div>
          </div>
          <div class="glass rounded-2xl p-6 border-white/10">
            <div class="bg-gradient-to-br from-emerald-500/20 to-green-600/20 rounded-2xl p-8 text-center"><div class="text-5xl font-black gradient-text mb-4">FD</div><p class="text-white/70 mb-6">Financial Analytics Dashboard</p><div class="space-y-4 text-center"><div><p class="text-emerald-200 text-3xl font-black">KPI</p><p class="text-white/60 text-sm">Summary cards</p></div><div class="border-t border-white/10 pt-4"><p class="text-cyan-200 text-3xl font-black">Charts</p><p class="text-white/60 text-sm">Interactive trends</p></div><div class="border-t border-white/10 pt-4"><p class="text-purple-200 text-3xl font-black">Filters</p><p class="text-white/60 text-sm">Exploration</p></div></div></div>
          </div>
        </div>
      </article>

      

      <article class="glass rounded-3xl p-8 md:p-12 border-white/10">
        <div class="grid md:grid-cols-2 gap-12 items-center">
          <div>
            <h2 class="text-4xl md:text-5xl font-black gradient-text mb-4">GRS Operations Dashboard (Demo)</h2>
            <p class="text-lg text-white/80 mb-6">A business systems demonstration using synthetic sample data to showcase operational metrics, trends, filters, and forecasting. It is not connected to GRS production systems.</p>
            <div class="space-y-6 mb-8">
              <div><h3 class="text-white font-bold mb-2">Goal</h3><p class="text-white/70">Show how a management-oriented dashboard can organize sample operational metrics into an interface for exploration and review.</p></div>
              <div><h3 class="text-white font-bold mb-2">Implementation</h3><p class="text-white/70">Python, Pandas, and Streamlit power sample-data visualizations, filters, trend charts, and forecasting examples. The published repository is the source for this demo.</p></div>
              <div><h3 class="text-white font-bold mb-2">What it demonstrates</h3><ul class="text-white/70 space-y-2"><li>✓ Interactive KPI and chart views</li><li>✓ Date and category filters</li><li>✓ Demo-data forecasting and reporting patterns</li></ul></div>
              <div class="glass p-6 rounded-2xl border-emerald-300/30 bg-emerald-500/10"><h3 class="text-emerald-100 font-bold mb-3">Tech Stack</h3><p class="text-emerald-100/80">Python • Streamlit • Pandas • Plotly</p></div>
            </div>
            <div class="flex gap-4"><a href="https://grsdashboard.streamlit.app/" target="_blank" rel="noopener noreferrer" class="gradient-border glass px-6 py-3 rounded-2xl font-semibold hover:scale-105 transition-all">Live Demo</a><a href="https://github.com/Vinodvinum/GRS_Dashboard" target="_blank" rel="noopener noreferrer" class="glass px-6 py-3 rounded-2xl font-semibold border border-white/30 hover:scale-105 transition-all">View Source</a></div>
          </div>
          <div class="glass rounded-2xl p-6 border-white/10"><div class="bg-gradient-to-br from-emerald-500/20 to-teal-600/20 rounded-2xl p-8 text-center"><div class="text-5xl font-black gradient-text mb-4">GR</div><p class="text-white/70 mb-6">GRS Analytics Dashboard Demo</p><div class="space-y-4 text-center"><div><p class="text-emerald-200 text-3xl font-black">Demo</p><p class="text-white/60 text-sm">Synthetic data</p></div><div class="border-t border-white/10 pt-4"><p class="text-cyan-200 text-3xl font-black">KPIs</p><p class="text-white/60 text-sm">Operational views</p></div><div class="border-t border-white/10 pt-4"><p class="text-purple-200 text-3xl font-black">Filters</p><p class="text-white/60 text-sm">Exploration</p></div></div></div></div>
        </div>
      </article>

      <div class="mt-24 text-center"><p class="text-white/80 mb-6">Interested in exploring more projects?</p><a href="/#projects" class="gradient-border glass px-8 py-4 rounded-2xl font-semibold text-lg hover:scale-105 transition-all inline-block">View All Projects</a></div>
    </div>
  </section>
</BaseLayout>
