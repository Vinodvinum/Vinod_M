---
import { ClientRouter } from 'astro:transitions';
import Navbar from '../components/common/Navbar.astro';
import Footer from '../components/common/Footer.astro';
import { navItems } from '../data/nav';
import { socialLinks } from '../data/social-links';
import { routeLabels } from '../data/seo';
import { absoluteUrl, buildBreadcrumbSchema, buildOrganizationSchema, buildPersonSchema, buildWebsiteSchema, schemaToJson, siteConfig } from '../utils/seo';
import '../styles/global.css';
import '../styles/animations.css';

const {
  title = 'Vinod M | Business Systems, Automation & Applied AI',
  description = 'Vinod M, also known as Vinu, is a technology professional from Mysuru, Karnataka building business systems, workflow automation, internal applications, and applied AI solutions.',
  canonical,
  ogImage = '/images/profile.jpg',
  pageType = 'website',
  extraSchemas = [],
} = Astro.props;

const pathname = Astro.url.pathname || '/';
const siteUrl = canonical ?? absoluteUrl(pathname);
const ogImageUrl = ogImage.startsWith('http') ? ogImage : absoluteUrl(ogImage);
const keywordSet = [...siteConfig.commonNames, 'Mysuru', 'Business Systems', 'Process Engineering', 'Workflow Automation', 'Software Engineering', 'Applied AI', 'Generative AI'];
const segments = pathname.split('/').filter(Boolean);
const breadcrumbs = segments.length === 0 ? [] : [
  { name: 'Home', item: absoluteUrl('/') },
  ...segments.map((segment, index) => {
    const currentPath = `/${segments.slice(0, index + 1).join('/')}`;
    return { name: routeLabels[currentPath] ?? decodeURIComponent(segment).replace(/-/g, ' '), item: absoluteUrl(currentPath) };
  }),
];
const baseSchemas = [
  buildWebsiteSchema(title, description, pathname),
  buildPersonSchema(description, pathname),
  buildOrganizationSchema(description, pathname),
  ...(breadcrumbs.length > 1 ? [buildBreadcrumbSchema(breadcrumbs)] : []),
  ...extraSchemas,
];
---

<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="google-site-verification" content="4sH8w1UB22GW_tOm5i2TONQV5KFerDbf_xMkwDCcPCw" />
    <meta name="author" content={siteConfig.name} />
    <meta name="keywords" content={keywordSet.join(', ')} />
    <meta name="robots" content="index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1" />
    <link rel="canonical" href={siteUrl} />
    <link rel="manifest" href="/manifest.json" />
    <meta name="theme-color" content="#020617" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content={pageType} />
    <meta property="og:url" content={siteUrl} />
    <meta property="og:image" content={ogImageUrl} />
    <meta property="og:site_name" content="Vinod M" />
    <meta property="og:locale" content="en_IN" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageUrl} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/images/profile.jpg" />
    <script src="/scripts/global.js" is:inline></script>
    <ClientRouter />
    {baseSchemas.map((schema) => (<script type="application/ld+json" set:html={schemaToJson(schema)} />))}
  </head>
  <body class="relative min-h-screen">
    <div id="particles" class="fixed inset-0 pointer-events-none z-0"></div>
    <Navbar {navItems} />
    <main id="main"><slot /></main>
    <Footer {socialLinks} />
    <a href={`https://wa.me/${socialLinks.whatsapp}`} class="fixed bottom-8 right-8 z-50 glass w-16 h-16 rounded-3xl shadow-2xl hover:scale-110 transition-all duration-300 group flex items-center justify-center text-3xl" target="_blank" rel="noopener noreferrer" aria-label="Chat on WhatsApp">💬</a>
  </body>
</html>
