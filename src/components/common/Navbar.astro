---
import { navItems } from '../../data/nav';
---

<nav class="site-nav">
  <a href="#main" class="skip-nav">Skip to main content</a>
  <div class="nav-inner">
    <a href="/" class="nav-brand" aria-label="Vinod M home">
      <img src="/images/profile.jpg" alt="" width="42" height="42" />
      <span class="nav-brand-copy"><strong>Vinod M</strong><small>Business Systems · Data · AI</small></span>
    </a>
    <div class="nav-desktop">
      {navItems.map((item) => <a href={item.href}>{item.label}</a>)}
    </div>
    <button id="mobile-menu" class="nav-toggle" type="button" aria-controls="mobile-menu-items" aria-expanded="false" aria-label="Open navigation menu">
      <svg viewBox="0 0 24 24" width="21" height="21" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><path d="M3 7h18M3 12h18M3 17h18"/></svg>
    </button>
  </div>
  <div id="mobile-menu-items" class="nav-mobile-menu" hidden>
    {navItems.map((item) => <a href={item.href}>{item.label}<span aria-hidden="true">↗</span></a>)}
  </div>
</nav>

<style>
  .site-nav{position:fixed;inset:0 0 auto;z-index:1000;background:rgba(6,10,16,.9);border-bottom:1px solid #ffffff12;backdrop-filter:blur(16px);-webkit-backdrop-filter:blur(16px)}
  .nav-inner{max-width:1240px;min-height:72px;margin:0 auto;padding:10px 24px;display:flex;align-items:center;justify-content:space-between;gap:24px}
  .nav-brand{display:flex;align-items:center;gap:11px;min-width:0;text-decoration:none}.nav-brand img{display:block;width:42px;height:42px;object-fit:cover;border-radius:50%;border:1px solid #c9a95d55}.nav-brand-copy{display:flex;flex-direction:column;gap:3px}.nav-brand-copy strong{color:#e4cd8c;font-size:1.12rem;line-height:1.2;font-weight:700}.nav-brand-copy small{color:#a0adaf;font-size:.62rem;line-height:1.4;letter-spacing:.08em;text-transform:uppercase}
  .nav-desktop{display:flex;align-items:center;gap:4px}.nav-desktop a{padding:10px 11px;color:#b3c0c0;font-size:.82rem;text-decoration:none;border-bottom:1px solid transparent;transition:color .2s,border-color .2s}.nav-desktop a:hover,.nav-desktop a:focus-visible{color:#f0dfb0;border-color:#c9a95d;outline:none}
  .nav-toggle{display:none;width:42px;height:42px;border:1px solid #c9a95d55;background:#0b121a;color:#e9d7a3;align-items:center;justify-content:center;cursor:pointer}.nav-toggle svg{display:block}
  .nav-mobile-menu{max-width:1240px;margin:0 auto;padding:0 24px 16px}.nav-mobile-menu[hidden]{display:none}.nav-mobile-menu a{display:flex;justify-content:space-between;align-items:center;padding:12px 3px;border-top:1px solid #ffffff12;color:#d4dcda;text-decoration:none;font-size:.92rem}.nav-mobile-menu a span{color:#c9a95d}
  .skip-nav{position:absolute;left:-9999px;top:0;padding:12px;background:#d8bf7c;color:#081016;z-index:1100}.skip-nav:focus{left:12px}
  @media(max-width:1100px){.nav-inner{min-height:66px;padding:8px 18px;gap:14px}.nav-desktop{display:none}.nav-toggle{display:flex}}
  @media(max-width:480px){.nav-inner{padding:8px 15px;min-height:63px}.nav-brand img{width:38px;height:38px}.nav-brand-copy strong{font-size:1rem}.nav-brand-copy small{font-size:.55rem;letter-spacing:.045em}.nav-toggle{width:39px;height:39px}}
  @media(prefers-reduced-motion:reduce){.nav-desktop a{transition:none}}
</style>