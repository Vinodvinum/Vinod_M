---
const capabilityGroups = [
  {
    number: '01',
    title: 'Data & Intelligence',
    thesis: 'Make information reliable, understandable, and useful for a decision.',
    capabilities: ['SQL & Python', 'Data cleaning & validation', 'Power BI', 'KPI dashboards', 'Analytics & decision support'],
    outcome: 'From raw tables to reporting people can act on.'
  },
  {
    number: '02',
    title: 'Business Systems & Automation',
    thesis: 'Turn a business requirement into a workflow with clear ownership and controls.',
    capabilities: ['MIS & FMS', 'Process engineering', 'Workflow & checklist design', 'Google Sheets & Apps Script', 'APIs & internal applications'],
    outcome: 'From manual coordination to visible, repeatable execution.'
  },
  {
    number: '03',
    title: 'Applied AI & Engineering',
    thesis: 'Use models and software where they solve a real problem—not just to add AI.',
    capabilities: ['Machine learning', 'NLP & NER', 'Computer vision', 'Document intelligence', 'AI-enabled applications'],
    outcome: 'From a technical prototype to a usable product capability.'
  }
];
---

<section id="skills" class="capabilities-section">
  <div class="capabilities-wrap">
    <header class="capabilities-heading">
      <p class="section-eyebrow">THREE CONNECTED DISCIPLINES</p>
      <h2>Three toolkits.<br/><span>One way of thinking.</span></h2>
      <p>The tool comes second. First understand the problem; then build the simplest dependable way to solve it.</p>
    </header>
    <div class="capabilities-grid">
      {capabilityGroups.map((group) => (
        <article class="capability-card">
          <div class="capability-topline"><span>{group.number} / CAPABILITY</span><span class="capability-mark" aria-hidden="true">{group.number === '01' ? '∑' : group.number === '02' ? '↗' : '✳'}</span></div>
          <h3>{group.title}</h3>
          <p class="capability-thesis">{group.thesis}</p>
          <div class="capability-rule" aria-hidden="true"></div>
          <p class="capability-label">WHAT I WORK WITH</p>
          <ul>{group.capabilities.map((capability) => <li>{capability}</li>)}</ul>
          <p class="capability-outcome">{group.outcome}</p>
        </article>
      ))}
    </div>
  </div>
</section>

<style>
  .capabilities-section{position:relative;z-index:1;padding:clamp(66px,8vw,108px) 22px;color:#edece4;background:linear-gradient(180deg,#0a1118 0%,#080d14 100%);border-top:1px solid #ffffff10;border-bottom:1px solid #ffffff10}
  .capabilities-wrap{max-width:1180px;margin:0 auto}.capabilities-heading{max-width:760px;margin-bottom:40px}.section-eyebrow{color:#c7ad69;font:600 .67rem/1.7 Inter,system-ui,sans-serif;letter-spacing:.22em}.capabilities-heading h2{margin-top:14px;font:600 clamp(2.4rem,5.3vw,4.5rem)/1.04 Inter,system-ui,sans-serif;letter-spacing:-.055em}.capabilities-heading h2 span{color:#ddc27e}.capabilities-heading>p:last-child{max-width:650px;margin-top:17px;color:#a7b4b6;font-size:1rem;line-height:1.8}
  .capabilities-grid{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:16px}.capability-card{display:flex;flex-direction:column;min-width:0;padding:24px 22px 22px;background:#0d151d;border:1px solid #d0b77527;transition:border-color .25s ease,background .25s ease}.capability-card:hover{border-color:#c9a95d65;background:#101a22}.capability-topline{display:flex;align-items:center;justify-content:space-between;color:#83c6c9;font:600 .58rem/1.6 Inter,system-ui,sans-serif;letter-spacing:.16em}.capability-mark{display:grid;place-items:center;width:31px;height:31px;border:1px solid #c9a95d50;border-radius:50%;font:500 1.05rem Georgia,serif;color:#e1ca8c}.capability-card h3{margin-top:20px;color:#f0e8d5;font:600 1.38rem/1.3 Inter,system-ui,sans-serif;letter-spacing:-.035em}.capability-thesis{margin-top:12px;color:#a5b4b5;font-size:.88rem;line-height:1.8;min-height:77px}.capability-rule{width:35px;height:1px;background:#c9a95d;margin:20px 0 18px}.capability-label{color:#879b9f;font:600 .58rem/1.6 Inter,system-ui,sans-serif;letter-spacing:.16em}.capability-card ul{display:flex;flex-direction:column;gap:10px;margin-top:13px;padding:0;list-style:none}.capability-card li{position:relative;padding-left:14px;color:#d0d8d2;font-size:.82rem;line-height:1.65}.capability-card li:before{content:"";position:absolute;left:0;top:.62em;width:5px;height:5px;background:#c9a95d;border-radius:50%}.capability-outcome{margin-top:auto;padding-top:23px;color:#e0c887;font:italic .88rem/1.7 'Cormorant Garamond',Georgia,serif}
  @media(max-width:900px){.capabilities-grid{grid-template-columns:1fr;gap:12px}.capability-card{padding:22px}.capability-thesis{min-height:0}.capability-card ul{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:9px 14px}.capability-outcome{padding-top:19px}}
  @media(max-width:520px){.capabilities-section{padding:60px 19px}.capabilities-heading{margin-bottom:28px}.capabilities-heading h2{font-size:clamp(2.25rem,10vw,3rem)}.capability-card{padding:19px}.capability-card h3{font-size:1.25rem}.capability-card ul{grid-template-columns:1fr}.capability-card li{font-size:.82rem}}
  @media(prefers-reduced-motion:reduce){.capability-card{transition:none}}
</style>